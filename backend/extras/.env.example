GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite
PUBLIC_BASE_URL=http://localhost:8001
SMS_PROVIDER=mock
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
# 1 = тестовый аккаунт Eskiz: уходит «Bu Eskiz dan test» вместо нашего текста
ESKIZ_TEST_MODE=1
# на публичном адресе: длинная случайная строка; маршруты владельца требуют X-Admin-Token
EXTRAS_ADMIN_TOKEN=
# Защита от SMS незнакомцам: при SMS_PROVIDER=eskiz настоящие SMS уходят только на эти номера.
# Демо-должник Alisher получает номер DEMO_DEBTOR_PHONE (свой или командный).
DEMO_DEBTOR_PHONE=
SMS_ALLOWLIST=
# 1 — только в боевом режиме с реальными должниками
SMS_ALLOW_ANY=0
