BOT_TOKEN=
GEMINI_API_KEY=
# несколько ключей через запятую (первый основной); переключение на 429/403
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-flash-latest
WEBAPP_URL=
# голосовые ответы на голосовые вопросы (Gemini TTS)
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Fola
VOICE_REPLIES=1
# кнопка «Demo reset» в /app (Ctrl+Shift+R) — только для демо-бизнеса DEV_SHOP_ID
DEMO_RESET=0
# mock bank feed: card/QR sale every DEMO_FEED_SECONDS for the demo shop
DEMO_FEED=0
DEMO_FEED_SECONDS=60
DEV_SHOP_ID=1
# --- SMS-напоминания и оплата по ссылке (backend/extras) ---
# адрес фронтенда: ссылка в SMS = PUBLIC_BASE_URL/pay/<token> (пусто -> WEBAPP_URL без /tg)
PUBLIC_BASE_URL=
# mock = SMS не уходит, пишется в backend/data/outbox.jsonl; eskiz = настоящая отправка через Eskiz.uz
SMS_PROVIDER=mock
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
# 1 = тестовый аккаунт Eskiz: уходит «Bu Eskiz dan test», в приложении виден настоящий текст
ESKIZ_TEST_MODE=1
# защита от SMS незнакомцам (режим eskiz): только номер демо-должника и список; SMS_ALLOW_ANY=1 — в бою
DEMO_DEBTOR_PHONE=
SMS_ALLOWLIST=
SMS_ALLOW_ANY=0
